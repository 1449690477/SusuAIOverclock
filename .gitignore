# deps
node_modules/

# build output
dist-electron/
# 历史构建产物备份（dist-electron.pre<ver>-<ts>/ 一类）。
# 注意：`dist-electron/` 只精确匹配该目录名，备份目录曾以未跟踪状态混进 `git add -A`。
dist-electron.*/
release/
release-final/
release-next/
.security-quarantine-*/

# 词库快照（24MB，构建产物，由 npm run refresh:library 重新生成）
build/library/

# 抓取临时目录（脚本自动写入，不入库）
.scrape/

# 六个工具包本体（377MB，不入库；构建时由 electron-builder 打入 resources/packs）
packed-packs/

# logs & temp
*.log
npm-debug.log*
vite.config.mjs.timestamp-*.mjs

# Python 编译缓存（开发时跑脚本产生；打包过滤规则同样排除 __pycache__/ 与 *.pyc）
__pycache__/
*.pyc

# 发布脚本（../_push-github.sh）的上传状态文件，自动写入，不入库
.gh-upload.json

# os
.DS_Store
Thumbs.db
desktop.ini
