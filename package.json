{
  "name": "dango-desk",
  "version": "1.5.6",
  "private": true,
  "description": "苏苏 AI超频 - 六个发布工具包与平台管理；新增 Claude Code 破甲包；Codex 冷咖啡石井、Codex 胖虎、反重力旧载荷默认隔离，勾选知情同意后方可安装",
  "main": "electron/main.cjs",
  "author": "Wanghan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1449690477/SusuAIOverclock.git"
  },
  "homepage": "https://github.com/1449690477/SusuAIOverclock#readme",
  "bugs": {
    "url": "https://github.com/1449690477/SusuAIOverclock/issues"
  },
  "scripts": {
    "build": "vite build",
    "dev:electron": "npm run build && electron .",
    "smoke": "node tests/desktop-smoke.mjs",
    "test": "node --test tests/core.test.cjs",
    "test:security": "node --test tests/security-quarantine.test.cjs tests/security-preflight.test.cjs",
    "audit:security": "node scripts/collect-security-evidence.cjs",
    "patch:portable": "node scripts/apply-portable-patch.cjs",
    "pack:portable": "node scripts/preflight-security.cjs && npm run patch:portable && vite build && node scripts/pack-portable.cjs",
    "scrape:library": "node scripts/scrape-details.cjs",
    "snapshot:library": "node scripts/build-library-snapshot.cjs",
    "refresh:library": "npm run scrape:library && npm run snapshot:library"
  },
  "dependencies": {
    "http-proxy-agent": "^9.1.0",
    "lucide-react": "^0.460.0",
    "playwright-core": "^1.48.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "44.4.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "playwright": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.susu.ai-overclock",
    "productName": "苏苏 AI超频",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "beforePack": "./scripts/before-build.cjs",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json",
      "node_modules/playwright-core/**/*",
      "node_modules/http-proxy-agent/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/proxy-agent-negotiate/**/*"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*"
    ],
    "extraResources": [
      {
        "from": "packed-packs",
        "to": "packs",
        "filter": [
          "cursor/**",
          "dsh/**",
          "claude/**",
          "opencode/**",
          "workbuddy/**",
          "workbuddy-ai/**",
          "NOTICE.txt",
          "!**/_deprecated-omen-bridge/**",
          "!**/backups/**",
          "!**/evidence/**",
          "!**/__pycache__/**",
          "!**/_quarantine/**",
          "!**/_cli-layer-state.json",
          "!**/_inject-layer-state.json",
          "!**/*.pyc"
        ]
      },
      {
        "from": "build/library",
        "to": "library",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "packElevateHelper": false
    },
    "portable": {
      "artifactName": "SusuAIOverclock-${version}-portable.exe",
      "unpackDirName": "SusuAIOverclockPortable"
    }
  }
}
